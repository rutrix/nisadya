# See https://help.github.com/articles/ignoring-files/ for more information about the ignore rules.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*

# Playwright test logs, anywhere in the tree
.playwright-cli/

# firebase
firebase-debug.log
firestore-debug.log
tunnel.log

# The baked sheet and its media hold people's names and phone numbers. scripts/bake.mjs makes them
# for every build and dev start, so they never enter git (history is permanent).
/src/data/baked.json
/public/media/
